# Allow only runtime Python sources and requirements into the local image.
**
!Dockerfile.local
!requirements.txt
!common/
!common/*.py
!customer_service/
!customer_service/*.py
!order_service/
!order_service/*.py
!task_scheduler/
!task_scheduler/*.py
!payment_service/
!payment_service/*.py
!kitchen_workflow/
!kitchen_workflow/*.py
!restaurant_service/
!restaurant_service/*.py
!delivery_assignment_service/
!delivery_assignment_service/*.py
!notification_service/
!notification_service/*.py
!local/
!local/*.py

!web_ui/
!web_ui/*.py
!web_ui/templates/
!web_ui/templates/*.html
!web_ui/templates/pages/
!web_ui/templates/pages/*.html
!web_ui/static/
!web_ui/static/*.css
!web_ui/static/*.js
!web_ui/static/*.svg

!deploy/
!deploy/*.py
!restaurant_service/*.proto
