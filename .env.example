# Copy to .env, enter your values, then load them as described in readme.
# Values are literal: do not add surrounding quotes or inline comments.
APP_ENV=production
PROJECT_ID=your-gcp-project-id

# Both existing order API implementations currently use orders_db.
# This username matches customer_service/sql.tf; override it if needed.
DB_USER=customer_service_user
DB_PASSWORD=
# Use a reachable MySQL host, or a local proxy/listener.
DB_PRIVATE_IP=127.0.0.1
DB_PORT=3306
DB_NAME=orders_db

# Secure cloud default. Local Compose selects its own explicit local settings.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Local example; in Kubernetes this may be zookeeper-client:2181.
ZK_HOSTS=127.0.0.1:2181
